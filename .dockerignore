# Cargo build artifacts. The double-star prefixes match nested target
# dirs, which BuildKit prunes at the walk stage, so the huge target
# tree never enters the tarball. Without these explicit nested forms,
# `az acr build` and some other tar packers walk the entire tree
# before applying patterns and spend minutes on a no-op.
target/
**/target/
**/.cargo/registry/
**/.cargo/git/
.git/
docs/
.fastembed_cache/
**/.fastembed_cache/
.DS_Store

# Local Pulumi state cache (not needed in container).
deploy/azure/node_modules/

# Documentation (not needed in container)
*.md
!deploy/README.md

# Frontend build artifacts
node_modules/
**/node_modules/
**/dist/

# IDE and editor configs
.claude/
.continue/
.cursor/
.vscode/
.windsurf/

# Workflow and planning state
.magistr/
.magistr-roadmap.yml
.magistr-roadmap.yml.lock
.mcp.json
launch/

# Signing credentials
.env.signing

# GitHub metadata
.github/

# Evaluation and benchmarks (not needed in container)
eval/
